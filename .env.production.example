# PlayerPath — productie
#
# Plak dit in Forge (Site → Environment) en vul de puntjes in. Alles wat hier
# leeg staat is een geheim dat je uit een ander scherm haalt; zet het nergens
# in git. De uitleg per blok staat in DEPLOY.md.

APP_NAME=PlayerPath
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://playerpath.nl

# Het basisdomein waar de subdomeinen van de scholen onder hangen
# (keepersschool-rob.playerpath.nl). LEEG LATEN zolang je geen
# wildcard-certificaat hebt: dan leidt Branding::fromHost() bewust geen school
# uit het adres af, komt de huisstijl uit het ingelogde account, en bereikt een
# school haar aanmeldpagina op playerpath.nl/inschrijven/{slug}. Zie DEPLOY.md.
APP_DOMAIN=

APP_LOCALE=nl
APP_FALLBACK_LOCALE=nl
APP_FAKER_LOCALE=nl_NL
APP_TIMEZONE=Europe/Amsterdam

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# Niet op debug: een productielogboek vol queries is onleesbaar én het staat
# vol met gegevens van kinderen.
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=playerpath
DB_USERNAME=forge
DB_PASSWORD=

# Redis voor cache, sessies en de wachtrij. De wachtrij mag niet in het verzoek
# draaien: het opslaan van een rapport moet in dertig seconden klaar zijn en
# mag nooit op een mailserver wachten.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Met de punt ervoor geldt de sessie voor playerpath.nl én alle subdomeinen.
# Op één domein maakt dat niets uit; zet je later subdomeinen aan, dan is één
# keer inloggen genoeg in plaats van opnieuw per school. Veilig, want het
# subdomein bepaalt alleen de huisstijl — welke gegevens iemand ziet hangt
# uitsluitend van zijn account af.
SESSION_DOMAIN=.playerpath.nl

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Op een eigen server hoeft dit niet: 0 en 1 zijn dan van PlayerPath alleen.
# Deelt de server met andere Laravel-apps, haal deze twee dan uit het commentaar
# en kies vrije nummers (Redis heeft er standaard zestien). De sleutelprefix is
# al uniek per app, dus botsen doet het niet — maar met eigen databases raakt
# `cache:clear` of `queue:flush` gegarandeerd nooit de app van een ander.
# REDIS_DB=4
# REDIS_CACHE_DB=5

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail via Brevo. Het afzenderadres is van het platform; de afzendernáám is per
# mail de school (zie Notifications\Concerns\SendsFromSchool). Zet SPF, DKIM en
# DMARC klaar vóór de eerste school, anders belandt een uitnodiging in de spam.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@playerpath.nl
MAIL_FROM_NAME=PlayerPath

VITE_APP_NAME="${APP_NAME}"

# Betalingen. Leeg = niet aangesloten: de app verplaatst dan geen cent en elk
# scherm zegt dat eerlijk. Eerst test_..., pas na de hele keten live_...
MOLLIE_KEY=
# Demo-betalingen: de hele flow zonder dat er geld beweegt. Alleen voor een
# demo-omgeving; op productie weigert playerpath:check het.
PAYMENTS_DEMO=false
